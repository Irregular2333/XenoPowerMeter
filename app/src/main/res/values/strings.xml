    <!-- Changelog entries. One array per release, read by ChangelogScreen. -->
    <string-array name="changelog_2_1_0">
        <item>Fixed chart display errors and incorrect units</item>
        <item>Improved the home page</item>
        <item>Improved the liquid bottom bar and progressive blur</item>
        <item>Improved tablet layout adaptation</item>
        <item>Improved haptic feedback</item>
        <item>Removed some in-app toast prompts</item>
    </string-array>
    <string-array name="changelog_2_0_3">
        <item>Improved the app\'s visual presentation</item>
        <item>Optimized the tablet layout</item>
        <item>Added liquid bottom bar and progressive blur</item>
        <item>Fixed the chart grid display issue</item>
    </string-array>
    <string-array name="changelog_2_0_2">
        <item>Added chart zoom</item>
        <item>Added a recording duration limit</item>
        <item>Improved app stability</item>
        <item>Improved the device page logic</item>
    </string-array>
    <string-array name="changelog_2_0_1">
        <item>Further reduced APK size</item>
        <item>Improved app stability and smoothness</item>
        <item>Improved recording stability</item>
        <item>Improved multi-language stability</item>
        <item>Fixed occasional data loss while recording</item>
    </string-array>
    <string-array name="changelog_2_0_0">
        <item>New, simpler app icon</item>
        <item>Added notification, language, and theme customization</item>
        <item>Added auto-connect for devices</item>
        <item>Added a confirmation dialog when clearing recorded data</item>
        <item>Improved dark mode</item>
        <item>Improved app visuals and large-screen adaptation</item>
        <item>Improved the bottom bar</item>
        <item>Improved recording stability and logic</item>
        <item>Improved export stability and logic</item>
        <item>Improved the app data cache retention logic</item>
        <item>Improved app smoothness and package size</item>
        <item>Fixed failure to read device calibration data</item>
    </string-array>
    <string-array name="changelog_1_4_0">
        <item>Added adaptive layouts for more screen ratios</item>
        <item>Added error prompts when connecting a device</item>
        <item>Fixed units not showing in some cases</item>
        <item>Fixed bottom bar and page conflicts in some cases</item>
    </string-array>
    <string-array name="changelog_1_3_0">
        <item>Added dark mode support (automatic switching)</item>
        <item>Fixed abnormal version number and build date</item>
    </string-array>
    <string-array name="changelog_1_2_0">
        <item>Added a floating bottom bar</item>
        <item>Added support for Xiaomi Super Island</item>
        <item>Fixed incorrect average power calculation</item>
        <item>Fixed crashes in some cases</item>
    </string-array>
