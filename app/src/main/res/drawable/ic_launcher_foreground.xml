<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher artwork with a baked-in 12% corner radius (generated from the
  square master bitmap kept in git history).
  Masked launchers only show the center ~2/3 of this layer, so the baked
  corners never affect the desktop icon — but ROMs that draw the icon
  unmasked on their launch splash (e.g. HyperOS) show rounded corners.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground_rounded"
    android:insetLeft="0dp"
    android:insetTop="0dp"
    android:insetRight="0dp"
    android:insetBottom="0dp" />
